{
  "$schema": "./config.schema.json",
  "task": {
    "title": "",
    "description": ""
  },
  "repo_path": ".",
  "max_loops": 8,
  "env_file": ".env",
  "env_override": false,
  "manifest_dir": null,
  "logging": {
    "level": "INFO",
    "file": ".repomind/logs/agent.log",
    "json": false,
    "to_console": true
  },
  "llm": {
    "provider": "openai_compatible",
    "model": "<model-name>",
    "api_base": "https://<host>/v1",
    "api_key_env": "LLM_API_KEY",
    "timeout": 60,
    "temperature": 0.0,
    "max_output_chars": 12000,
    "response_format_mode": "auto",
    "context": {},
    "context_compressor": {},
    "planner": {},
    "plan": {},
    "action_policy": {
      "max_completion_tokens": 4096,
      "extra_body": { "thinking_budget": 2048 }
    },
    "action": {},
    "task_analysis": {},
    "observer": {},
    "memory_extractor": {},
    "memory_relation": {},
    "code_context_query": {},
    "code_context_rerank": {},
    "skill_selector": {},
    "final_reporter": {},
    "completion_judge": {
      "max_completion_tokens": 8192,
      "extra_body": { "thinking_budget": 4096 }
    },
    "structured_fallback": true,
    "max_retries": 2
  },
  "modes": {
    "planner": "llm",
    "context_compressor": "rule_based",
    "action_policy": "llm",
    "task_analyzer": "llm",
    "observer": "llm",
    "code_context_query_planner": "llm",
    "code_context_reranker": "llm",
    "skill_selector": "llm",
    "final_reporter": "llm",
    "completion_judge": "llm"
  },
  "memory": {
    "path": ".repomind/session_memory.db",
    "max_turns": 6,
    "max_chars": 12000,
    "file_cache_max_files": 50,
    "file_cache_max_spans": 200,
    "file_cache_max_bytes": 10485760
  },
  "archive": {
    "enabled": true,
    "path": ".repomind/archive/tasks",
    "max_text_chars": 200000,
    "max_source_file_bytes": 200000,
    "max_source_total_bytes": 2000000
  },
  "long_term_memory": {
    "document_path": ".repomind/memory",
    "catalog_path": ".repomind/memory/catalog.sqlite3",
    "semantic_index_path": ".repomind/memory/semantic.sqlite3",
    "catalog_busy_timeout_ms": 5000,
    "keyword_candidate_multiplier": 8,
    "retrieval_enabled": true,
    "retrieval_mode": "keyword",
    "retrieval_limit": 8,
    "retrieval_max_chars": 12000,
    "retrieval_min_score": 0.1,
    "retrieval_include_draft": true,
    "retrieval_max_refreshes": 3,
    "retrieval_max_queries": 4,
    "retrieval_type_limits": {
      "preference": 2,
      "semantic": 4,
      "procedural": 2,
      "anti_pattern": 2,
      "episodic": 2
    },
    "consolidation_path": ".repomind/consolidation/runs",
    "pipeline_version": "consolidation-v3",
    "extractor_mode": "rule_based",
    "max_candidates": 24,
    "semantic_merge_mode": "disabled",
    "semantic_top_k": 5,
    "semantic_min_similarity": 0.78,
    "semantic_relation_min_confidence": 0.85,
    "embedding": {
      "provider": "disabled",
      "model": "",
      "api_base": "",
      "api_key_env": "LLM_API_KEY",
      "timeout": 60,
      "dimensions": 0,
      "batch_size": 32
    },
    "semantic_candidates": 24,
    "semantic_min_score": 0.5,
    "semantic_timeout": 5.0,
    "query_cache_size": 256,
    "rrf_k": 60,
    "keyword_weight": 1.0,
    "semantic_weight": 1.0,
    "scope_matched_weight": 1.1,
    "scope_unknown_weight": 0.5,
    "scope_unknown_limit": 2
  },
  "context": {
    "enabled": true,
    "compressor_mode": "llm",
    "max_tokens": 32000,
    "compression_threshold": 0.75,
    "compression_target": 0.55,
    "recent_items": 8,
    "min_new_tokens": 1200
  },
  "observer": {
    "use_delta": true,
    "full_state_on_severe": true,
    "write_threshold": 0.35,
    "store_limit": 12
  },
  "code_context": {
    "index_path": ".repomind/codebase_context/index.json",
    "query_limit": 10,
    "selected_limit": 12,
    "rerank_candidate_limit": 40
  },
  "skill": {
    "selected_limit": 5
  },
  "rl": {
    "enabled": false,
    "q_table_path": ".repomind/rl/q_table.json",
    "replay_path": ".repomind/rl/replay.jsonl",
    "epsilon": 0.15,
    "learning_rate": 0.2,
    "discount": 0.9,
    "replay_max_size": 10000,
    "train_batch_size": 32
  },
  "editing": {
    "enabled": true,
    "max_files": 5,
    "max_changed_lines": 300,
    "max_file_bytes": 200000,
    "require_read_before_write": true,
    "confidence_threshold": 0.75,
    "allow_create": false
  },
  "approval": {
    "require_step_approval": false
  },
  "trace_dir": ".repomind/traces",
  "execution_enabled": false,
  "execution_env": {},
  "execution_timeout": 300,
  "execution_model_calls": 16,
  "execution_tool_calls": 32,
  "execution_retries": 8,
  "execution_startup_timeout": 30,
  "execution_operation_timeout": 30,
  "execution_cleanup_timeout": 5,
  "execution_resources": {
    "memory_limit_mb": 2048,
    "cpu_limit_percent": 50,
    "max_processes": 64,
    "mode": "strict"
  }
}
